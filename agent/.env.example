# NetMonitor Agent configuration
# Copy this file to .env and fill with values from the NetMonitor web UI.

# Cloud backend HTTP base URL (Railway, etc.)
BACKEND_URL=https://your-app.up.railway.app

# Cloud backend WebSocket endpoint
WS_URL=wss://your-app.up.railway.app/ws/agent

# Agent token for this site (from NetMonitor web UI → site detail)
AGENT_TOKEN=incolla-qui-il-token-del-sito

# Rete da scansionare. VUOTO = ricavata dalla rotta di sottorete
# sull'interfaccia che porta al gateway. Compilare solo se sbaglia.
SCAN_NETWORK=

# Gateway del sito. VUOTO = ricavato dalla rotta di default.
GATEWAY_IP=

# Client per richiesta
CLIENT_BATCH_SIZE=50

# How often to send telemetry (seconds)
TELEMETRY_INTERVAL=60

# Logging
LOG_LEVEL=INFO

# Timeouts (seconds)
PING_TIMEOUT=0.8
SNMP_TIMEOUT=1.0

# Heartbeat interval (seconds)
HEARTBEAT_INTERVAL=30

# Reconnect delay on disconnect (seconds)
RECONNECT_DELAY=5

# SNMP communities to try, comma separated
SNMP_COMMUNITIES=public,private
